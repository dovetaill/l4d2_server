[Unit]
Description=CN77 L4D2 Release Download Server
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/l4d2-release

[Service]
Type=simple
User=l4d2srv
Group=l4d2srv
WorkingDirectory=/var/lib/l4d2-release
ExecStart=/opt/l4d2/scripts/serve_cn77_release.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/l4d2-release

[Install]
WantedBy=multi-user.target
