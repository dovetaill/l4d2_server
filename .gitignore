# Local deployment state
logs/
incoming/*
!incoming/.gitkeep
backups/
archives/
tmp/
Steam/
tools/
sources/

# Keep the installed game runtime on disk, but track only the curated
# SourceMod source/config/binary baseline listed below.
server/*
!server/left4dead2/

server/left4dead2/*
!server/left4dead2/addons/
!server/left4dead2/cfg/

server/left4dead2/addons/*
!server/left4dead2/addons/sourcemod/

server/left4dead2/addons/sourcemod/*
!server/left4dead2/addons/sourcemod/configs/
!server/left4dead2/addons/sourcemod/data/
!server/left4dead2/addons/sourcemod/plugins/
!server/left4dead2/addons/sourcemod/scripting/

# SourceMod administrator configuration owned by this deployment.
server/left4dead2/addons/sourcemod/configs/*
!server/left4dead2/addons/sourcemod/configs/admins_simple.ini
!server/left4dead2/addons/sourcemod/configs/adminmenu_custom.txt

# Custom compiled plugins. Third-party installed binaries remain runtime-only.
server/left4dead2/addons/sourcemod/plugins/*
!server/left4dead2/addons/sourcemod/plugins/l4d2_campaign_shop.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_clear_thirdstrike.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_combat_rewards.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_double_jump.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_end_safearea_teleport.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_pve_admin.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_pve_infected_core.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_switch_ammo.smx

# Custom SourcePawn sources and the one reviewed third-party source.
server/left4dead2/addons/sourcemod/scripting/*
!server/left4dead2/addons/sourcemod/scripting/l4d2_campaign_shop.sp
!server/left4dead2/addons/sourcemod/scripting/l4d2_clear_thirdstrike.sp
!server/left4dead2/addons/sourcemod/scripting/l4d2_combat_rewards.sp
!server/left4dead2/addons/sourcemod/scripting/l4d2_end_safearea_teleport.sp
!server/left4dead2/addons/sourcemod/scripting/l4d2_pve_admin.sp
!server/left4dead2/addons/sourcemod/scripting/l4d2_pve_infected_core.sp
!server/left4dead2/addons/sourcemod/scripting/l4d2_switch_upgrade_ammo.sp
!server/left4dead2/addons/sourcemod/scripting/include/
!server/left4dead2/addons/sourcemod/scripting/third_party/

server/left4dead2/addons/sourcemod/scripting/include/*
!server/left4dead2/addons/sourcemod/scripting/include/l4d2_campaign_shop.inc

server/left4dead2/addons/sourcemod/scripting/third_party/*
!server/left4dead2/addons/sourcemod/scripting/third_party/l4d2_double_jump.sp

# Server configuration maintained by this project.
server/left4dead2/cfg/*
!server/left4dead2/cfg/server.cfg
!server/left4dead2/cfg/pve_core.cfg
!server/left4dead2/cfg/pve_balance.cfg
!server/left4dead2/cfg/sourcemod/

server/left4dead2/cfg/sourcemod/*
!server/left4dead2/cfg/sourcemod/l4d2_campaign_shop.cfg
!server/left4dead2/cfg/sourcemod/l4d2_clear_thirdstrike.cfg
!server/left4dead2/cfg/sourcemod/l4d2_combat_rewards.cfg
!server/left4dead2/cfg/sourcemod/l4d2_end_safearea_teleport.cfg
!server/left4dead2/cfg/sourcemod/l4d2_switch_ammo.cfg
!server/left4dead2/cfg/sourcemod/l4d2_pve_infected_core.cfg
!server/left4dead2/cfg/sourcemod/l4dinfectedbots.cfg
!server/left4dead2/cfg/sourcemod/l4dmultislots.cfg
!server/left4dead2/cfg/sourcemod/pve_infected_balance.cfg

# PvPvE runtime data maintained by this project.
server/left4dead2/addons/sourcemod/data/*
!server/left4dead2/addons/sourcemod/data/l4dinfectedbots/
server/left4dead2/addons/sourcemod/data/l4dinfectedbots/*
!server/left4dead2/addons/sourcemod/data/l4dinfectedbots/pve_pvpve.cfg
!server/left4dead2/addons/sourcemod/data/mutant_tanks/
server/left4dead2/addons/sourcemod/data/mutant_tanks/*
!server/left4dead2/addons/sourcemod/data/mutant_tanks/mutant_tanks.cfg

# Generated logs, local databases and crash artifacts outside ignored runtime.
*.log
*.sqlite
*.db
*.dmp
*.mdmp
*.core

# Downloaded package formats.
*.tar.gz
*.tgz
*.zip

# Editor and operating-system files.
.DS_Store
Thumbs.db
.idea/
.vscode/
