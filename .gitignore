!server/left4dead2/addons/sourcemod/data/
!server/left4dead2/addons/sourcemod/plugins/
!server/left4dead2/addons/sourcemod/scripting/

# SourceMod administrator configuration owned by this deployment.
server/left4dead2/addons/sourcemod/configs/*
!server/left4dead2/addons/sourcemod/configs/admins_simple.ini
!server/left4dead2/addons/sourcemod/configs/adminmenu_custom.txt
