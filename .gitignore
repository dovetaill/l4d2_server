# PvPvE runtime data maintained by this project.
server/left4dead2/addons/sourcemod/data/*
!server/left4dead2/addons/sourcemod/data/l4dinfectedbots/
server/left4dead2/addons/sourcemod/data/l4dinfectedbots/*
!server/left4dead2/addons/sourcemod/data/l4dinfectedbots/pve_pvpve.cfg
!server/left4dead2/addons/sourcemod/data/mutant_tanks/
server/left4dead2/addons/sourcemod/data/mutant_tanks/*
!server/left4dead2/addons/sourcemod/data/mutant_tanks/mutant_tanks.cfg
!server/left4dead2/addons/sourcemod/data/mutant_tanks/mutant_tanks_detours.cfg

# Generated logs, local databases and crash artifacts outside ignored runtime.
*.log
*.sqlite
*.db
*.dmp
*.mdmp
*.core

# Downloaded package formats.
*.tar.gz
*.tgz
*.zip

# Editor and operating-system files.
.DS_Store
Thumbs.db
.idea/
.vscode/
__pycache__/
*.py[cod]

# H opens the player-visible Chinese MOTD/help page.
!server/left4dead2/motd.txt

# SourcePawn compile dependencies required by the PvE admin/core plugins.
!server/left4dead2/addons/sourcemod/scripting/include/left4dhooks*.inc
!server/left4dead2/addons/sourcemod/scripting/include/l4dinfectedbots.inc
!server/left4dead2/addons/sourcemod/scripting/include/mutant_tanks.inc
