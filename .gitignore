# Local deployment state
logs/
incoming/*
!incoming/.gitkeep
backups/
archives/
tmp/
Steam/
tools/
sources/

# Keep the installed game runtime on disk, but track only the curated
# SourceMod source/config/binary baseline listed below.
server/*
!server/left4dead2/

server/left4dead2/*
!server/left4dead2/addons/
!server/left4dead2/cfg/

server/left4dead2/addons/*
!server/left4dead2/addons/sourcemod/

server/left4dead2/addons/sourcemod/*
!server/left4dead2/addons/sourcemod/configs/
!server/left4dead2/addons/sourcemod/data/
!server/left4dead2/addons/sourcemod/plugins/
!server/left4dead2/addons/sourcemod/scripting/

# SourceMod administrator configuration owned by this deployment.
server/left4dead2/addons/sourcemod/configs/*
!server/left4dead2/addons/sourcemod/configs/admins_simple.ini
!server/left4dead2/addons/sourcemod/configs/adminmenu_custom.txt
!server/left4dead2/addons/sourcemod/configs/pve_help_content.cfg
!server/left4dead2/addons/sourcemod/configs/pve_hostname.txt

# Custom compiled plugins. Third-party installed binaries remain runtime-only.
server/left4dead2/addons/sourcemod/plugins/*
!server/left4dead2/addons/sourcemod/plugins/l4d2_campaign_shop.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_clear_thirdstrike.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_combat_rewards.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_double_jump.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_end_safearea_teleport.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_pve_help_menu.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_pve_admin.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_pve_infected_core.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_pve_damage_display.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_playable_witch.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_pve_mutant_tanks.smx
!server/left4dead2/addons/sourcemod/plugins/l4d2_switch_ammo.smx
!server/left4dead2/addons/sourcemod/plugins/command_buffer.smx

# Custom SourcePawn sources and the one reviewed third-party source.
server/left4dead2/addons/sourcemod/scripting/*
!server/left4dead2/addons/sourcemod/scripting/l4d2_campaign_shop.sp
!server/left4dead2/addons/sourcemod/scripting/l4d2_automatic_weapons.sp
!server/left4dead2/addons/sourcemod/scripting/l4d2_unicode_hostname.sp
